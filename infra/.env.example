# Variáveis do ambiente local (Docker Compose).
# Copie para infra/.env e ajuste se quiser: cp infra/.env.example infra/.env
# Todos os valores são fictícios e servem só para desenvolvimento local.
# O arquivo infra/.env é ignorado pelo Git: nunca versione senhas reais.

# PostgreSQL: superusuário de administração e banco da aplicação
POSTGRES_DB=registro_demandas
POSTGRES_USER=admin_demandas
POSTGRES_PASSWORD=senha-ficticia-admin

# PostgreSQL: usuário da aplicação (dono do banco, sem superusuário). O backend usa este.
APP_DB_USER=app_demandas
APP_DB_PASSWORD=senha-ficticia-app

# pgAdmin: login da interface web
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=senha-ficticia-pgadmin

# Portas publicadas só em 127.0.0.1. Troque se já estiverem em uso na sua máquina.
DB_PORT=5432
PGADMIN_PORT=5050
